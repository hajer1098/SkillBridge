# Copy to /opt/skillbridge/.env.production ON THE VPS. Keep it out of Git/Jenkins artifacts.
DOCKER_DATABASE_NAME=skillbridge
DOCKER_DATABASE_USER=skillbridge
DOCKER_DATABASE_PASSWORD=replace-with-a-unique-long-random-password
POSTGRES_IMAGE=postgres:17-alpine
FRONTEND_PORT=8088
PUBLIC_ORIGIN=https://learn.example.com

# First deployment: provision an administrator without enabling known development passwords.
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-admin-password-at-least-12-characters
BOOTSTRAP_ADMIN_NAME=SkillBridge Admin

# Set these for registration verification and password-reset email.
MAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_TLS=true
MAIL_FROM=hello@example.com

# Optional server-only recommendation provider settings.
AI_URL=
AI_API_KEY=
AI_MODEL=
