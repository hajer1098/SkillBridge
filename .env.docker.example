# Development Docker stack. Use a different password from your local pgAdmin login.
DOCKER_DATABASE_NAME=skillbridge-db
DOCKER_DATABASE_USER=skillbridge
DOCKER_DATABASE_PASSWORD=replace-with-a-long-random-password
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8088
REGISTRY_PREFIX=skillbridge
IMAGE_TAG=local
# Default source builds; use Dockerfile.prebuilt only after building the app artifacts locally.
DOCKER_BUILD_FILE=Dockerfile
# Development seed accounts are for local testing. See deployment instructions before VPS use.
DEMO_SEED=true
MAIL_ENABLED=false
CORS_ORIGINS=http://localhost:8088,http://127.0.0.1:8088
