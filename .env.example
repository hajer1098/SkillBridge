# Leave unset for the browser-local demo. Set /api to use Vite's Spring Boot proxy.
VITE_API_URL=/api
# Server settings: export these in the environment starting Java / Docker Compose.
DATABASE_URL=jdbc:postgresql://localhost:5432/skillbridge
DATABASE_USER=skillbridge
DATABASE_PASSWORD=skillbridge_dev
DEMO_SEED=true
MAIL_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=1025
# Optional server-only provider endpoint, key, and model. NEVER prefix these with VITE_.
AI_URL=
AI_API_KEY=
AI_MODEL=
