# npm run api reads these server settings from .env. Keep credentials out of VITE_*.
DATABASE_URL=jdbc:postgresql://localhost:5432/skillbridge-db
DATABASE_USER=your_database_user
DATABASE_PASSWORD=your_database_password
DEMO_SEED=true
MAIL_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
# Optional server-only provider endpoint, key, and model. NEVER prefix these with VITE_.
AI_URL=
AI_API_KEY=
AI_MODEL=
